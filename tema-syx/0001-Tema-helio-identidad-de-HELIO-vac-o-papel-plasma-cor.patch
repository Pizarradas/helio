+// SYX — Entry point: helio
+// ================================================
+// Compiles to: css/styles-theme-helio.css
+// Made with `npm run theme:new helio` from scss/themes/_template/.
+// ================================================
+
+// THEME SETUP (tokens + reset + helpers + atoms + molecules + organisms)
+@use 'themes/helio/setup';
+
+// UTILITIES (text, display, spacing utility classes)
+@use 'utilities/index' as *;
