index 0000000..16e6fba
--- /dev/null
+++ b/scss/themes/helio/_setup.scss
@@ -0,0 +1,40 @@
+// ================================================
+// PLANTILLA DE TEMA — CABLEADO
+// ================================================
+// Lo instancia `npm run theme:new <nombre>`: copia los .scss de esta carpeta
+// y pone el nombre del tema en los mixins y en las llamadas de bundle. Nada
+// más: la lista de componentes vive en _shared/_bundle-full.scss y la de
+// fuentes en el _theme.scss de este tema (theme-x-fonts).
+// ================================================
+
+// CORE
+@use '../_base/universal' as *;
+@use '../_shared/core' as *;
+@use '../_shared/bundle-full' as *;
+// @use '../../site/bundle-site' as *; // CAPA DEL SITIO — ver abajo
+@use 'theme' as *;
+
+// THEME TOKENS
+// ================================================
+@include universal-values();
+@include theme-helio();
+
+// FONTS (declared once in _theme.scss)
+// ================================================
+@include theme-helio-fonts();
+
+// CORE (reset + elements + helpers + grid)
+// ================================================
+@include syx-core(helio);
+
+// FULL SYSTEM BUNDLE (every atom, molecule, organism)
+// ================================================
+@include syx-bundle-full(helio);
+
+// CAPA DEL SITIO — solo la llevan los temas que pintan las páginas de SYX
+// (home.html, docs.html…). Un tema para un producto NO: es mobiliario del
+// sitio. Para pintarlo, descomenta esta línea y el @use de arriba. Sin
+// ella el tema viaja igual en el paquete (bundle-docs, bundle-core) y
+// build-dist lo deja fuera de dist/site/.
+// ================================================
+// @include syx-bundle-site(helio);
diff --git a/scss/themes/helio/_theme.scss b/scss/themes/helio/_theme.scss
new file mode 100644
index 0000000..42d2a7a
--- /dev/null
+++ b/scss/themes/helio/_theme.scss
@@ -0,0 +1,199 @@
+// ================================================
+// TEMA HELIO — «Del núcleo a la Tierra»
+// ================================================
+// Identidad de HELIO, la landing sobre los procesos atómicos del Sol.
+// Diseño: José Luis Pizarro.
+//
+// Dirección: CUADERNO DE OBSERVATORIO. Dos superficies que nunca se mezclan:
+//   · el VACÍO (oscuro, con una deriva violeta mínima): el espacio. Es el modo
+//     oscuro y también la superficie de énfasis en los dos modos, porque el
+//     espacio no tiene modo claro;
+//   · el PAPEL de placa (crudo, cálido): la libreta del observatorio, el
+//     modo claro.
+// Tres luces, cada una con su significado físico y nunca decorativa:
+//   · PLASMA (oro → naranja): la energía de fusión, el primario;
+//   · CORONA (cian frío): el plasma a millones de grados visto en UV, el
+//     secundario;
+//   · AURORA (verde de oxígeno a 557,7 nm): lo que llega a la Tierra, el
+//     terciario.
+// Tipografía: Instrument Serif para los titulares (la voz del cuaderno),
+// Hanken Grotesk para el cuerpo y JetBrains Mono para cifras, unidades y
+// rótulos de instrumento. Métricas leídas de los woff2 con
+// skill--grid-system/09-herramientas/gridcalc.py (L13).
+// Forma: esquinas vivas, filetes de 1px. El énfasis lo da la escala, no el peso.
+// ================================================
+
+@use '../../abstracts/index' as *;
+
+@mixin theme-helio {
+  :root {
+    // ================================================
+    // 1 · MARCA
+    // ================================================
+    // VACÍO (hue 285: el negro del cielo con la deriva violeta de una placa)
+    --primitive-color-helio-void-950: oklch(0.13 0.018 285);
+    --primitive-color-helio-void-900: oklch(0.165 0.02 285);
+    --primitive-color-helio-void-850: oklch(0.2 0.022 285);
+    --primitive-color-helio-void-800: oklch(0.25 0.024 285);
+    // PAPEL de placa fotográfica (hue 80: crudo cálido, nunca blanco puro)
+    --primitive-color-helio-paper-50: oklch(0.972 0.011 82);
+    --primitive-color-helio-paper-100: oklch(0.948 0.015 80);
+    --primitive-color-helio-paper-200: oklch(0.915 0.019 78);
+    --primitive-color-helio-paper-300: oklch(0.86 0.021 76);
+    // PLASMA (del oro de 5.772 K al naranja de la cromosfera)
+    --primitive-color-helio-plasma-300: oklch(0.86 0.13 82);
+    --primitive-color-helio-plasma-400: oklch(0.82 0.155 72);
+    --primitive-color-helio-plasma-600: oklch(0.6 0.19 42);
+    --primitive-color-helio-plasma-700: oklch(0.52 0.18 36);
+    // CORONA (UV en falso color: cian frío)
+    --primitive-color-helio-corona-400: oklch(0.8 0.11 215);
+    --primitive-color-helio-corona-500: oklch(0.72 0.12 222);
+    --primitive-color-helio-corona-700: oklch(0.47 0.11 238);
+    // AURORA (oxígeno atómico, 557,7 nm)
+    --primitive-color-helio-aurora-400: oklch(0.85 0.17 155);
+    --primitive-color-helio-aurora-500: oklch(0.78 0.17 155);
+    --primitive-color-helio-aurora-700: oklch(0.48 0.12 160);
+
+    // Unidad de espacio: 0.5rem. Con el cuerpo a 16px da 8px, la mitad de la
+    // unidad u = 24px que deriva `gridcalc compose` (interlineado 1.5).
+    --primitive-space-base: 0.5rem;
+
+    // ================================================
+    // 2 · ROLES DE MARCA (modo claro: papel)
+    // ================================================
+    --semantic-color-primary: var(--primitive-color-helio-plasma-700);
+    --semantic-color-secondary: var(--primitive-color-helio-corona-700);
+    --semantic-color-tertiary: var(--primitive-color-helio-aurora-700);
+    --semantic-color-state-hover-primary: var(--primitive-color-helio-plasma-600);
+    --semantic-color-state-hover-secondary: var(--primitive-color-helio-corona-500);
+
+    // TINTA SOBRE RELLENO (on-*): sobre los rellenos oscuros del papel, tinta
+    // clara; sobre los claros, oscura. Lo valida `npm run check:contraste`.
+    --semantic-color-on-primary: var(--semantic-color-ink-light);
+    --semantic-color-on-secondary: var(--semantic-color-ink-light);
+    --semantic-color-on-tertiary: var(--semantic-color-ink-light);
+    --semantic-color-on-quaternary: var(--semantic-color-ink-dark);
+    --semantic-color-on-quinary: var(--semantic-color-ink-dark);
+    --semantic-color-on-state-hover-primary: var(--semantic-color-ink-dark);
+    --semantic-color-on-state-hover-secondary: var(--semantic-color-ink-dark);
+    --semantic-color-on-state-hover-tertiary: var(--semantic-color-ink-dark);
+    --semantic-color-on-state-hover-quaternary: var(--semantic-color-ink-dark);
+
+    // SUPERFICIES: el papel. El énfasis es el vacío también en claro: el
+    // espacio no tiene modo claro.
+    --semantic-color-bg-primary: var(--primitive-color-helio-paper-50);
+    --semantic-color-bg-secondary: var(--primitive-color-helio-paper-100);
+    --semantic-color-bg-tertiary: var(--primitive-color-helio-paper-200);
+    --semantic-color-bg-emphasis: var(--primitive-color-helio-void-950);
+
+    // ================================================
+    // 3 · TEXTO — la tinta del cuaderno (hue 285, la del vacío)
+    // ================================================
+    --semantic-color-text-primary: oklch(0.2 0.02 285);
+    --semantic-color-text-secondary: oklch(0.42 0.02 285);
+    --semantic-color-text-tertiary: oklch(0.49 0.018 285);
+
+    // ================================================
+    // 4 · FORMA — esquinas vivas de instrumento
+    // ================================================
+    --semantic-border-radius-sm: 0;
+    --semantic-border-radius-default: 0.125rem;
+    --semantic-border-radius-lg: 0.25rem;
+    --theme-radius: var(--semantic-border-radius-default);
+    // 1440px: el ancho máximo del contenido que fija `gridcalc compose --max`.
+    --layout-max-width: calc(180 * var(--primitive-space-base));
+
+    // ================================================
+    // 5 · TIPOGRAFÍA
+    // ================================================
+    --semantic-font-family-primary: "Hanken Grotesk", "Hanken Grotesk Fallback", Arial, sans-serif;
+    --semantic-font-family-primary-bold: var(--semantic-font-family-primary);
+    --semantic-font-family-heading: "Instrument Serif", "Instrument Serif Fallback", "Times New Roman", serif;
+    --semantic-font-family-heading-md: var(--semantic-font-family-primary);
+    --semantic-font-family-mono: "JetBrains Mono", "DM Mono", "Courier New", monospace;
+    // Instrument Serif solo tiene un peso: el titular no pide negrita sintética.
+    --semantic-font-weight-heading: var(--primitive-font-weight-regular);
+    // Interlineado del cuerpo: 1.5, el de `gridcalc compose --use reading`.
+    --semantic-line-height-body: 1.5;
+
+    // ================================================
+    // 6 · ICONOS
+    // ================================================
+    --icon-arrow-default: var(--lc-icon-chevron-right);
+    --icon-arrow-double: var(--lc-icon-chevrons-right);
+    --icon-content-bars: var(--lc-icon-menu);
+    --icon-rrss-email: var(--lc-icon-mail);
+    --icon-user-interface-cancel: var(--lc-icon-x);
+    --icon-user-interface-exclamation-mark: var(--lc-icon-warning);
+    --icon-user-interface-home: var(--lc-icon-home);
+    --icon-user-interface-tick: var(--lc-icon-check);
+  }
+
+  // ================================================
+  // 7 · MODO OSCURO — el vacío. Dos entradas, las dos con dark-mode-tokens()
+  // ================================================
+  @media (prefers-color-scheme: dark) {
+    :root:not([data-theme="light"]) {
+      @include dark-mode-tokens();
+      @include theme-helio-dark();
+    }
+  }
+
+  :root[data-theme="dark"] {
+    @include dark-mode-tokens();
+    @include theme-helio-dark();
+  }
+
+  :root[data-theme="light"] {
+    color-scheme: light;
+  }
+}
+
+// Lo que el tema afina en oscuro, una sola vez para las dos entradas.
+@mixin theme-helio-dark {
+  --semantic-color-primary: var(--primitive-color-helio-plasma-400);
+  --semantic-color-on-primary: var(--semantic-color-ink-dark);
+  --semantic-color-state-hover-primary: var(--primitive-color-helio-plasma-300);
+  --semantic-color-on-state-hover-primary: var(--semantic-color-ink-dark);
+  --semantic-color-secondary: var(--primitive-color-helio-corona-400);
+  --semantic-color-on-secondary: var(--semantic-color-ink-dark);
+  --semantic-color-state-hover-secondary: var(--primitive-color-helio-corona-500);
+  --semantic-color-tertiary: var(--primitive-color-helio-aurora-400);
+  --semantic-color-on-tertiary: var(--semantic-color-ink-dark);
+  --semantic-color-bg-primary: var(--primitive-color-helio-void-950);
+  --semantic-color-bg-secondary: var(--primitive-color-helio-void-900);
+  --semantic-color-bg-tertiary: var(--primitive-color-helio-void-850);
+  --semantic-color-bg-emphasis: var(--primitive-color-helio-void-900);
+  --semantic-color-text-primary: var(--primitive-color-helio-paper-100);
+  --semantic-color-text-secondary: oklch(0.78 0.015 285);
+  --semantic-color-text-tertiary: oklch(0.7 0.015 285);
+}
+
+// ================================================
+// 8 · FUENTES — propias, en fonts/helio/ (licencia SIL OFL 1.1)
+// ================================================
+// Los respaldos métricos salen de `gridcalc.py font <woff2> --fallback`:
+// mientras carga la fuente web, el respaldo ocupa lo mismo y no hay salto.
+@mixin theme-helio-fonts {
+  @include font-family("Hanken Grotesk", "#{$fonts-path}/helio/HankenGrotesk-Variable", 100 900, normal);
+  @include font-family("Instrument Serif", "#{$fonts-path}/helio/InstrumentSerif-Regular", 400, normal);
+  @include font-family("Instrument Serif", "#{$fonts-path}/helio/InstrumentSerif-Italic", 400, italic);
+  @include font-family("JetBrains Mono", "#{$fonts-path}/helio/JetBrainsMono-Variable", 100 800, normal);
+  @font-face {
+    font-family: "Hanken Grotesk Fallback";
+    src: local("Arial"), local("ArialMT"), local("Liberation Sans"), local("Arimo");
+    size-adjust: 99.96%;
+    ascent-override: 100.04%;
+    descent-override: 30.31%;
+    line-gap-override: 0%;
+  }
+  @font-face {
+    font-family: "Instrument Serif Fallback";
+    src: local("Times New Roman"), local("TimesNewRomanPSMT"), local("Liberation Serif"), local("Tinos");
+    size-adjust: 83.23%;
+    ascent-override: 118.95%;
+    descent-override: 37.25%;
+    line-gap-override: 0%;
+  }
+  @include syx-font("DM Mono", 400);
+}
